#!/bin/zsh -f

# Send a message as the next prompt of a running Claude session, given the
# session's ID, as a message from another session with the given name.
#
# usage: send-claude-session FROM SESSION-ID MESSAGE
#
# Each running Claude session keeps a record, named after its process ID,
# that names its messaging socket, and a key file next to the record holds
# the token that the socket requires before any message. A record whose
# process is no longer running, or that cannot be read, is skipped. The
# Claude app stops the processes of idle sessions when it needs room under
# its limit on running sessions and when memory is short, and such a
# session cannot be sent a message this way.
#
# The session sees a message from another session rather than one typed in
# its prompt box. A session holds a message for its user's approval when the
# message states a permission mode other than the session's own, and a
# session in bypass mode also holds a message that states none. The message
# therefore states the mode in the Claude app's record of the session, or,
# for a session the app did not start, the mode its transcript last
# recorded, which is out of date if the mode changed after the session's
# last turn. The socket does not acknowledge messages, so a message that the
# session holds or rejects is still reported as sent.

emulate zsh
setopt no_unset pipe_fail extended_glob
zmodload zsh/net/socket zsh/mapfile || exit

program=${0:t}
claude_home=${CLAUDE_CONFIG_DIR:-$HOME/.claude}
typeset from session message record pid= socket= host= mode=
typeset -a records key_files transcripts

if (( $# != 3 )); then
  print -u2 -- "usage: $program FROM SESSION-ID MESSAGE"
  exit 2
fi
from=$1 session=$2 message=$3

# A session's record gives its socket and, for a session the Claude app
# started, the app's ID for the session. jq reads only the records that
# contain the session's ID.
for record in $claude_home/sessions/<->.json(N); do
  kill -0 ${record:t:r} 2>/dev/null || continue
  [[ ${mapfile[$record]-} == *"\"$session\""* ]] || continue
  { IFS= read -r socket; IFS= read -r host } < <(command jq -r --arg session "$session" '
    select(.sessionId == $session)
    | .messagingSocketPath // "", .hostSessionId // ""' $record)
  if [[ -n $socket ]]; then
    pid=${record:t:r}
    break
  fi
done
key_files=($claude_home/sessions/$pid.[0-9a-f](#c64).key(N))
if [[ -z $socket ]] || (( ${#key_files} != 1 )); then
  print -u2 -- "$program: no running Claude session $session can receive messages"
  exit 1
fi

# The Claude app keeps its record of each session in a file named after the
# app's ID for the session. It keeps a folder of records for each account and
# organization, so the same record can be in more than one. Folders with dots
# in their names hold records the app has set aside, for example when
# switching accounts. Each record is one line of JSON with no newline at its
# end, so each is printed with a newline of its own, and a damaged record
# spoils only its own line. Every user turn in the transcript also has the
# permission mode, so the transcript serves for a session the app did not
# start. The message states the mode as "bypass" or "prompting".
[[ -n $host ]] &&
  records=("$HOME/Library/Application Support/Claude/claude-code-sessions"/[^.]##/[^.]##/$host.json(N))
if (( ${#records} )); then
  mode=$(for record in $records; do print -r -- ${mapfile[$record]-}; done |
    command jq -n -R -r --arg session "$session" '[inputs | fromjson? //
      empty | select(.cliSessionId == $session and .permissionMode)]
      | max_by(.lastActivityAt // 0) // empty
      | "\"permissionMode\":\"\(.permissionMode)\""')
fi
transcripts=($claude_home/projects/*/$session.jsonl(N))
if [[ -z $mode ]] && (( ${#transcripts} == 1 )); then
  mode=$(command grep -a -o '"permissionMode":"[A-Za-z]*"' \
    "${transcripts[1]}" | command tail -n 1)
fi
[[ $mode == *'"bypassPermissions"' ]] && mode=bypass || mode=prompting

zsocket "$socket" || exit
command jq -c --arg from "$from" --arg message "$message" --arg mode "$mode" '
  if (.peerToken | type) != "string" then error("no messaging token")
  else {type: "auth", token: .peerToken},
    {type: "user", priority: "next", message: {content:
      "<cross-session-message from-name=\"\($from)\" from-mode=\"\($mode)\">\n\($message)\n</cross-session-message>"}}
  end' "${key_files[1]}" >&$REPLY
